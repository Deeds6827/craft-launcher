+        let listener = TcpListener::bind(("127.0.0.1", 0)).unwrap();
+        let mut socket = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+        let (connection, _) = listener.accept().unwrap();
+        let (tx, rx) = channel();
+        let ctx = egui::Context::default();
+        let worker = std::thread::spawn(move || serve(connection, tx, ctx, "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"));
+        control_auth::authenticate_client(&mut socket, "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef").unwrap();
+        socket.set_read_timeout(Some(Duration::from_secs(2))).unwrap();
+        writeln!(socket, "{}", json!({"id": 7, "method": "document.inspect", "params": {}})).unwrap();
+        let request = rx.recv_timeout(Duration::from_secs(2)).unwrap();
+        assert_eq!(request.method, "document.inspect");
+        request.reply.send(json!({"ok": true, "result": {"safe": true}})).unwrap();
+        let mut reply = String::new();
+        BufReader::new(&socket).read_line(&mut reply).unwrap();
+        let reply: serde_json::Value = serde_json::from_str(&reply).unwrap();
+        assert_eq!(reply["id"], 7);
+        assert_eq!(reply["result"]["safe"], true);
+        drop(socket);
+        worker.join().unwrap();
+    }
