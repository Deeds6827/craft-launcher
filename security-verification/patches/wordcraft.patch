-    Some(out)
+    let read = f.take(budget.remaining.saturating_add(1)).read_to_end(&mut out);
+    let consumed = out.len() as u64;
+    if consumed > budget.remaining {
+        budget.exceeded = true;
+        budget.remaining = 0;
+        return None;
+    }
+    // Corrupt entries consume work even when their bytes cannot be used as images.
+    budget.remaining = budget.remaining.saturating_sub(consumed);
+    read.ok().map(|_| out)
 }
 
