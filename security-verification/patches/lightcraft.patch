--- /dev/null
+++ b/crates/mcp/src/control_auth.rs
@@ -0,0 +1,157 @@
+//! First-frame authentication for the optional native control transport.
+use serde_json::{Value, json};
+#[cfg(not(target_arch = "wasm32"))]
+use std::io::Read;
+use std::io::{self, Write};
+use std::net::TcpStream;
+use std::time::Duration;
+#[cfg(not(target_arch = "wasm32"))]
+use std::time::Instant;
+
+pub const TOKEN_ENV: &str = "LIGHTCRAFT_CONTROL_TOKEN";
+pub const AUTH_TIMEOUT: Duration = Duration::from_secs(5);
+pub const MAX_AUTH: usize = 4096;
+
+pub fn validate_token(token: &str) -> io::Result<String> {
+    if token.len() != 64 || !token.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return Err(io::Error::new(io::ErrorKind::PermissionDenied, "control token must contain 64 hexadecimal characters"));
+    }
+    Ok(token.to_ascii_lowercase())
+}
+
+pub fn token_from_env() -> io::Result<String> {
+    let token = std::env::var(TOKEN_ENV).map_err(|_| {
+        io::Error::new(io::ErrorKind::PermissionDenied, format!("set {TOKEN_ENV} to a private 64-character hexadecimal token for the app and client"))
+    })?;
+    validate_token(&token)
+}
+
+fn denied() -> io::Error {
+    io::Error::new(io::ErrorKind::PermissionDenied, "control authentication failed")
+}
+
+/// Read without over-reading the following frame, with a total deadline (including slow peers).
+#[cfg(not(target_arch = "wasm32"))]
+#[allow(clippy::disallowed_methods)] // The native-only handshake may read the native clock.
+fn auth_line(stream: &mut TcpStream) -> io::Result<Value> {
+    let deadline = Instant::now() + AUTH_TIMEOUT;
+    let mut bytes = Vec::new();
+    loop {
+        let left = deadline.checked_duration_since(Instant::now()).ok_or_else(denied)?;
+        stream.set_read_timeout(Some(left))?;
+        let mut byte = [0u8; 1];
+        stream.read_exact(&mut byte)?;
+        if byte[0] == b'\n' {
+            return serde_json::from_slice(&bytes).map_err(|_| denied());
+        }
+        if bytes.len() == MAX_AUTH {
+            return Err(denied());
+        }
+        bytes.push(byte[0]);
+    }
+}
+
+#[cfg(target_arch = "wasm32")]
+fn auth_line(_stream: &mut TcpStream) -> io::Result<Value> {
+    Err(denied())
+}
+
+pub fn auth_request(token: &str) -> io::Result<String> {
+    let token = validate_token(token)?;
+    Ok(format!("{}\n", json!({"id": 0, "method": "auth", "params": {"token": token}})))
+}
+
+pub fn check_reply(reply: &Value) -> io::Result<()> {
+    if reply.get("id") == Some(&json!(0)) && reply.get("ok") == Some(&json!(true)) && reply["result"]["authenticated"] == true {
+        Ok(())
+    } else {
+        Err(denied())
+    }
+}
+
+pub fn authenticate_client(stream: &mut TcpStream, token: &str) -> io::Result<()> {
+    if !stream.peer_addr()?.ip().is_loopback() {
+        return Err(denied());
+    }
+    let read_timeout = stream.read_timeout()?;
+    let write_timeout = stream.write_timeout()?;
+    stream.set_write_timeout(Some(AUTH_TIMEOUT))?;
+    let result = (|| {
+        stream.write_all(auth_request(token)?.as_bytes())?;
+        check_reply(&auth_line(stream)?)
+    })();
+    stream.set_read_timeout(read_timeout)?;
+    stream.set_write_timeout(write_timeout)?;
+    result.map_err(|_| denied())
+}
+
+pub fn authenticate_server_with_token(stream: &mut TcpStream, expected: &str) -> io::Result<TcpStream> {
+    if !stream.peer_addr()?.ip().is_loopback() {
+        return Err(denied());
+    }
+    let expected = validate_token(expected)?;
+    stream.set_write_timeout(Some(AUTH_TIMEOUT))?;
+    let req = auth_line(stream)?;
+    let supplied = req["params"]["token"].as_str().and_then(|t| validate_token(t).ok());
+    let ok = req["method"] == "auth" && supplied.as_ref().is_some_and(|t| t.bytes().zip(expected.bytes()).fold(0u8, |a, (x, y)| a | (x ^ y)) == 0);
+    if !ok {
+        return Err(denied());
+    }
+    writeln!(stream, "{}", json!({"id": req.get("id").cloned().unwrap_or(Value::Null), "ok": true, "result": {"authenticated": true}}))?;
+    stream.set_read_timeout(None)?;
+    stream.set_write_timeout(None)?;
+    stream.try_clone()
+}
+
+#[cfg(test)]
+mod tests {
+    #![allow(clippy::unwrap_used, clippy::expect_used, clippy::panic)]
+    use super::*;
+    use std::io::{BufRead, BufReader};
+    use std::net::TcpListener;
+    const TOKEN: &str = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
+    #[test]
+    fn tokens_are_strict_and_errors_never_echo_them() {
+        for bad in ["", "abc", &"z".repeat(64), &"1".repeat(65)] {
+            assert!(validate_token(bad).is_err());
+        }
+        assert_eq!(validate_token(&TOKEN.to_uppercase()).unwrap(), TOKEN);
+    }
+    #[test]
+    fn authentication_preserves_the_next_frame() {
+        let listener = TcpListener::bind(("127.0.0.1", 0)).unwrap();
+        let mut client = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+        let (mut server, _) = listener.accept().unwrap();
+        let worker = std::thread::spawn(move || {
+            let read = authenticate_server_with_token(&mut server, TOKEN).unwrap();
+            let mut next = String::new();
+            BufReader::new(read).read_line(&mut next).unwrap();
+            assert_eq!(next, "next-command\n");
+        });
+        authenticate_client(&mut client, TOKEN).unwrap();
+        client.write_all(b"next-command\n").unwrap();
+        worker.join().unwrap();
+    }
+    #[test]
+    fn a_failed_handshake_is_an_authentication_error() {
+        let listener = TcpListener::bind(("127.0.0.1", 0)).unwrap();
+        let mut client = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+        let (mut server, _) = listener.accept().unwrap();
+        let worker = std::thread::spawn(move || {
+            assert!(authenticate_server_with_token(&mut server, &"f".repeat(64)).is_err());
+        });
+        assert_eq!(authenticate_client(&mut client, TOKEN).unwrap_err().kind(), io::ErrorKind::PermissionDenied);
+        worker.join().unwrap();
+    }
+    #[test]
+    fn wrong_tokens_http_and_oversized_frames_are_rejected() {
+        for frame in [auth_request(&"f".repeat(64)).unwrap(), "POST / HTTP/1.1\n".into(), "x".repeat(MAX_AUTH + 1)] {
+            let listener = TcpListener::bind(("127.0.0.1", 0)).unwrap();
+            let mut client = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+            let (mut server, _) = listener.accept().unwrap();
+            let worker = std::thread::spawn(move || authenticate_server_with_token(&mut server, TOKEN).is_err());
+            let _ = client.write_all(frame.as_bytes());
+            assert!(worker.join().unwrap());
+        }
+    }
+}
