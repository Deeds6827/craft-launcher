+fn control_line(reader: &mut std::io::BufReader<std::net::TcpStream>, deadline: Option<std::time::Instant>) -> std::io::Result<Option<String>> {
+    use std::io::BufRead;
+    let limit: usize = if deadline.is_some() { 4096 } else { 4 * 1024 * 1024 };
+    let mut line = Vec::new();
+    loop {
+        let timeout = match deadline {
+            Some(d) => d
+                .checked_duration_since(std::time::Instant::now())
+                .ok_or_else(|| std::io::Error::new(std::io::ErrorKind::TimedOut, "authentication timeout"))?,
+            None => std::time::Duration::from_secs(60),
+        };
+        reader.get_ref().set_read_timeout(Some(timeout))?;
+        let buf = reader.fill_buf()?;
+        if buf.is_empty() {
+            return if line.is_empty() { Ok(None) } else { Err(std::io::Error::new(std::io::ErrorKind::UnexpectedEof, "incomplete control frame")) };
+        }
+        let end = buf.iter().position(|b| *b == b'\n');
+        let count = end.map_or(buf.len(), |n| n + 1);
+        if count > limit.saturating_sub(line.len()) {
+            return Err(std::io::Error::other("control frame too large"));
+        }
+        line.extend_from_slice(&buf[..count]);
+        reader.consume(count);
+        if end.is_some() {
+            return String::from_utf8(line).map(Some).map_err(std::io::Error::other);
+        }
+    }
+}
