+fn host_output_rejects_oversized_messages_before_retaining_them() {
+    for call in ["console.println", "app.alert"] {
+        let out = go(&format!("{call}('x'.repeat(70_000));"), &Event::doc("Open"));
+        assert!(out.error.is_some(), "{call} must report the output limit");
