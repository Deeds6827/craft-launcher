+#[test]
+fn loopback_transport_releases_connection_slots_after_rejection() {
+    use std::io::{BufRead, BufReader, Write};
+    let (_h, client) = harness();
+    let endpoint = pdfcraft_ui_egui::control::serve(client).unwrap();
+    for _ in 0..32 {
+        let mut stream = std::net::TcpStream::connect(("127.0.0.1", endpoint.port)).unwrap();
+        stream.set_read_timeout(Some(std::time::Duration::from_secs(2))).unwrap();
+        writeln!(stream, "{}", json!({"id":0,"method":"auth","params":{"token":"wrong"}})).unwrap();
+        let mut reply = String::new();
+        BufReader::new(stream).read_line(&mut reply).unwrap();
+        let reply: Value = serde_json::from_str(&reply).unwrap();
+        assert_eq!(reply["error"]["code"], -32001);
+    }
+    // A later valid client can still authenticate after twice the maximum number of rejections.
+    let mut stream = std::net::TcpStream::connect(("127.0.0.1", endpoint.port)).unwrap();
+    stream.set_read_timeout(Some(std::time::Duration::from_secs(2))).unwrap();
+    writeln!(stream, "{}", json!({"id":7,"method":"auth","params":{"token":endpoint.token}})).unwrap();
+    let mut reply = String::new();
+    BufReader::new(stream).read_line(&mut reply).unwrap();
+    let reply: Value = serde_json::from_str(&reply).unwrap();
+    assert_eq!(reply["id"], 7);
+    assert_eq!(reply["result"]["ok"], true);
+}
